# For local Docker Compose setup:
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=skillsgraph123
NEO4J_DATABASE=neo4j

# AI provider configuration (centralized in core/ai.py):
LLM_PROVIDER=ollama             # "ollama" (default) or "openai"
LLM_MODEL_NAME=                 # Optional override (default: llama3.1 for ollama, gpt-4o-mini for openai)
LLM_TEMPERATURE=0.0             # LLM sampling temperature

OPENAI_API_KEY=sk-...           # Required only if LLM_PROVIDER=openai
OPENAI_BASE_URL=                # Custom OpenAI-compatible API base URL (optional)

OLLAMA_BASE_URL=http://localhost:11434  # Ollama server URL

EMBEDDING_MODEL=all-MiniLM-L6-v2       # sentence-transformers model for semantic search
SEMANTIC_THRESHOLD=0.9                  # Min cosine similarity for semantic match

# LangSmith tracing (centralized in core/ai.py):
LANGSMITH_TRACING=false                 # Set to "true" to enable tracing
LANGSMITH_API_KEY=                      # Your LangSmith API key
LANGSMITH_PROJECT=skills-graph          # Project name in LangSmith dashboard
LANGSMITH_ENDPOINT=https://api.smith.langchain.com  # LangSmith API endpoint
