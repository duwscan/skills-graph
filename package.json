    "ai": "^6.0.97",
    "async-mutex": "^0.5.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.2",
    "ioredis": "^5.9.3",
    "nanoid": "^5.1.6",
    "postgres": "^3.4.8",
